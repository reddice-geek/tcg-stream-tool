{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TCG STREAM TOOL",
  "version": "1.0.14",
  "identifier": "com.reddice.tcgstreamtool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TCG STREAM TOOL",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "licenseFile": "CHARTE_LEGALE.txt",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Reddice Geek",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "French",
          "English",
          "Spanish",
          "Italian"
        ],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDMkEwQzBENjJEMDI1QUEKUldTcUpkQmlEUXdxUFB5cUFzbGNyVG01OG1mZXhIZGR6d0h2eldRQ3NVOHR3WWJPQnZZNUhZVTgK",
      "endpoints": [
        "https://github.com/reddice-geek/tcg-stream-tool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
